# Cadence supports two LLM providers (OpenAI SDK compatible).
# Pick ONE; if both are set, DEEPSEEK_API_KEY wins.

# Recommended — cheap, no aggressive rate limit, workspace default.
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Fallback — Gemini 2.5 Flash. Free tier is 10 RPM and overloads often;
# the paid tier is fine. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
